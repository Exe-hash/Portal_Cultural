# Django
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-cadena-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Desarrollo rápido sin MySQL: usa DB_ENGINE=sqlite.
# Para phpMyAdmin/MySQL local o para EC2: usa DB_ENGINE=mysql.
DB_ENGINE=mysql
DB_NAME=portal_cultural
DB_USER=portal_cultural_user
DB_PASSWORD=cambia-esta-contrasena
DB_HOST=127.0.0.1
DB_PORT=3306

# Solo se utiliza cuando DB_ENGINE=sqlite.
SQLITE_NAME=db.sqlite3
